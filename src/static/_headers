# Cloudflare Pages response headers. The build copies this file to dist/_headers
# and fills in the style hashes with a hash of every inline <style> block, so the
# Content-Security-Policy only allows the exact CSS the site ships.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' {{STYLE_HASHES}}; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprinted files (name contains a content hash): cache for a year.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Icons keep a fixed name, so cache them for a day only.
/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400
/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
